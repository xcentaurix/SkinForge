#!/bin/bash
domain=$(getdomain "$1")
if [ -z "$domain" ]; then
	echo no valid domain specified
	exit 1
fi
echo "Domain: $domain"

git=$HOME/git
srcroot=$git/dev/$domain
dstroot=$git/rel/$domain
srcskin=$srcroot/src/skin
dstskin=$dstroot/src/skin
cmnroot=$git/dev/Common
cmnskin=$cmnroot/src/skin

scriptdir=$(dirname "$0")

if [ ! -d "$dstskin" ]; then
	echo "Error: $dstskin does not exist"
	exit 1
fi

for file in "$dstskin/"*; do
	[ -d "$file" ] || continue
	skin=$(basename "$file")

	if [ ! -f "$srcskin/$skin/skin.xml" ]; then
		continue
	else
		echo "skin: $skin"

		# convert yml to xml if a *.ymlinc or *.noymlinc changed in cmn for this variant
		if [ -n "$(git -C "$cmnroot" status --porcelain -- "src/skin/$skin/*.ymlinc" "src/skin/$skin/*.noymlinc" 2>/dev/null)" ]; then
			echo "cmn yml changed, reconverting..."
			(cd "$cmnroot" && "$scriptdir/yml2xmldomain" . "$skin")
			(cd "$cmnroot" && "$scriptdir/xmlprettydomain" . "$skin")
		else
			echo "cmn yml unchanged, skipping conversion"
		fi

		# convert yml to xml if a *.ymlinc or *.noymlinc changed in src for this variant
		if [ -n "$(git -C "$srcroot" status --porcelain -- "src/skin/$skin/*.ymlinc" "src/skin/$skin/*.noymlinc" 2>/dev/null)" ]; then
			echo "src yml changed, reconverting..."
			(cd "$srcroot" && "$scriptdir/yml2xmldomain" . "$skin")
			(cd "$srcroot" && "$scriptdir/xmlprettydomain" . "$skin")
		else
			echo "src yml unchanged, skipping conversion"
		fi

		# compile the xml source
		if [ -f "$dstskin/$skin/skin.xml" ]; then
			echo "compiling $dstskin/$skin/skin.xml..."
			"$scriptdir/xmlinc" "$srcskin/$skin/skin.xml" "$dstskin/$skin/skin.xml" "$dstskin/$skin" "$cmnskin/$skin"
			sed -i 's/%PLUGIN%/'$domain'/g' "$dstskin/$skin/skin.xml"
			"$scriptdir/xmlpretty" "$dstskin/$skin/skin.xml" "$dstskin/$skin/skin.xml"
		else
			echo "no skin.xml at $dstskin/$skin, skipping compile"
		fi
	fi
done
